{
  "$schema": "https://raw.githubusercontent.com/nicegui-org/nicegui/tauri-v2/nicegui/static/tauri/tauri.conf.json",
  "identifier": "org.flaxandteal.greasan",
  "productName": "Gréasán",
  "version": "0.1.0",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:mobile"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' asset: ipc: http://ipc.localhost http://tauri.localhost http://pfzip.localhost http://rmindex.localhost http://asset.localhost https://asset.localhost https://*.wiktionary.org; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**"]
      }
    },
    "windows": [
      {
        "title": "Gréasán",
        "width": 400,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "plugins": {
    "opener": {}
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "resources": {
      "../../data/bundle/heads/wiktionary-v2-full.zip": "heads/wiktionary-v2-full.zip",
      "../../data/bundle/heads/macbain-v2.zip": "heads/macbain-v2.zip",
      "../../data/bundle/heads/tearma-v2.zip": "heads/tearma-v2.zip",
      "../../data/wiktionary-index/pagefind-en.zip": "pagefind/wiktionary-index/pagefind-en.zip",
      "../../data/wiktionary-index/pagefind-ga.zip": "pagefind/wiktionary-index/pagefind-ga.zip",
      "../../data/wiktionary-index/pagefind-sampla.zip": "pagefind/wiktionary-index/pagefind-sampla.zip",
      "../../data/macbain-index/pagefind-en.zip": "pagefind/macbain-index/pagefind-en.zip",
      "../../data/macbain-index/pagefind-ga.zip": "pagefind/macbain-index/pagefind-ga.zip",
      "../../data/tearma-index/pagefind-ga.zip": "pagefind/tearma-index/pagefind-ga.zip",
      "../../data/tearma-index/pagefind-en.zip": "pagefind/tearma-index/pagefind-en.zip"
    }
  }
}
